<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Finalizar Pedido — Marmitária</title>
  <style>
    * {margin:0; padding:0; font-family: system-ui; box-sizing: border-box;}
    body {background: #fef6e4; padding: 20px; max-width: 500px; margin: 0 auto;}
    h1 {color: #d35400; text-align: center; margin-bottom: 20px;}
    .item {background: white; padding: 12px; border-radius: 8px; margin-bottom: 8px;}
    form {background: white; padding: 20px; border-radius: 12px; margin-top: 20px;}
    input, select, textarea {width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ddd; border-radius: 8px; font-size: 16px;}
    textarea {resize: vertical; min-height: 80px;}
    button {background: #27ae60; color: white; border: none; padding: 14px; border-radius: 8px; width: 100%; font-size: 17px; font-weight: bold; margin-top: 10px; cursor: pointer;}
    .total {font-size: 22px; font-weight: bold; color: #27ae60; text-align: right; margin: 15px 0;}
    .voltar {display: block; text-align: center; margin-bottom: 15px; color: #d35400; text-decoration: none;}
    .info {background: #e3f2fd; padding: 10px; border-radius: 8px; margin: 10px 0; font-size: 14px; color: #0d47a1;}
    .campo-existente {border-color: #27ae60; background: #f8fff8;}
  </style>
</head>
<body>
  <a href="cardapio.html" class="voltar">← Voltar ao Cardápio</a>
  <h1>🛒 Finalizar Pedido</h1>
  <div id="itens"></div>
  <div class="total" id="total">R$ 0,00</div>

  <div id="infoCliente" class="info" style="display:none;">
    ✅ Cliente já cadastrado! Restrições salvas serão aplicadas automaticamente.
  </div>

  <form id="form">
    <input type="text" id="nome" placeholder="Seu nome" required>
    <input type="tel" id="telefone" placeholder="Seu WhatsApp (com DDD)" required>
    <input type="email" id="email" placeholder="E-mail (opcional)">
    
    <label style="margin-top:12px; display:block; font-weight:600;">Restrições Alimentares / Alergias</label>
    <textarea id="restricoes" placeholder="Ex: Não como carne vermelha, alergia a leite, sem glúten, etc."></textarea>
    
    <select id="tipo">
      <option value="balcao">Retirada no Balcão</option>
      <option value="entrega">Entrega</option>
    </select>
    <textarea id="observacao" placeholder="Observação adicional (opcional)"></textarea>
    
    <button type="submit">✅ Confirmar Pedido</button>
  </form>

  <script>
    let carrinho = JSON.parse(localStorage.getItem('carrinho') || '[]');
    const total = carrinho.reduce((s, i) => s + i.preco * (i.qtd || 1), 0);

    document.getElementById('itens').innerHTML = carrinho.map(i => 
      `<div class="item">${i.nome} — R$ ${i.preco.toFixed(2)}</div>`
    ).join('');
    document.getElementById('total').innerText = `Total: R$ ${total.toFixed(2)}`;

    // Verificar se cliente já existe pelo telefone
    document.getElementById('telefone').addEventListener('blur', async function() {
      const tel = this.value.replace(/\D/g, '');
      if (tel.length >= 11) {
        const res = await fetch(`/api/clientes/verificar/${tel}`);
        const dados = await res.json();
        if (dados.existe) {
          document.getElementById('infoCliente').style.display = 'block';
          document.getElementById('nome').value = dados.cliente.nome;
          document.getElementById('nome').classList.add('campo-existente');
          if (dados.cliente.restricoes) {
            document.getElementById('restricoes').value = dados.cliente.restricoes;
            document.getElementById('restricoes').readOnly = true;
          }
        } else {
          document.getElementById('infoCliente').style.display = 'none';
          document.getElementById('nome').classList.remove('campo-existente');
          document.getElementById('restricoes').readOnly = false;
        }
      }
    });

    document.getElementById('form').addEventListener('submit', async e => {
      e.preventDefault();
      const btn = e.submitter;
      btn.innerText = 'Enviando...';
      btn.disabled = true;

      const res = await fetch('/api/pedidos', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          nome: document.getElementById('nome').value,
          telefone: document.getElementById('telefone').value.replace(/\D/g, ''),
          email: document.getElementById('email').value,
          restricoes: document.getElementById('restricoes').value,
          tipo: document.getElementById('tipo').value,
          observacao: document.getElementById('observacao').value,
          itens: carrinho.map(i => ({produto_id: i.id, quantidade: i.qtd || 1}))
        })
      });

      const dados = await res.json();
      if (dados.sucesso) {
        localStorage.removeItem('carrinho');
        alert(`✅ Pedido #${dados.pedidoId} confirmado!\nValor: R$ ${dados.valorTotal.toFixed(2)}\nEm breve estará pronto! 🥘`);
        window.location.href = 'cardapio.html';
      } else {
        alert('Erro: ' + (dados.erro || 'Tente novamente'));
        btn.innerText = '✅ Confirmar Pedido';
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
